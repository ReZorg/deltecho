{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "deltecho-chat-preview",
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2024-12-01",

  // Enable observability for container logs
  "observability": {
    "enabled": true
  },

  // Container configuration
  // Dockerfile is at repo root, path is relative to this wrangler.jsonc file
  "containers": [
    {
      "class_name": "DeltEchoContainer",
      "image": "registry.cloudflare.com/cdc9766260a44de95a8e4ce5aae55fdb/deltecho-chat:v8",
      "max_instances": 10,
      // Use immediate rollout to avoid gradual rollout issues
      "rollout_step_percentage": [100]
    }
  ],

  // Durable Objects binding for containers
  "durable_objects": {
    "bindings": [
      {
        "name": "DELTECHO_CONTAINER",
        "class_name": "DeltEchoContainer"
      }
    ]
  },

  // Required migration for Durable Objects with SQLite
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["DeltEchoContainer"]
    }
  ],

  // KV namespace binding for cognitive state persistence
  "kv_namespaces": [
    {
      "binding": "DTE_KV",
      "id": "0af56b6874c443e29f83aec82eeb92e7"
    }
  ],

  // R2 bucket binding for long-term echo memory archive
  "r2_buckets": [
    {
      "binding": "DTE_R2",
      "bucket_name": "deltecho-echo-memory"
    }
  ],

  // Environment variables (secrets should be set via wrangler secret)
  "vars": {
    "ENVIRONMENT": "preview"
  },

  // Development settings
  "dev": {
    "port": 8787,
    "local_protocol": "http"
  }
}
